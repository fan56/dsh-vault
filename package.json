{
  "name": "@aiwayds/dsh-vault",
  "version": "0.1.0",
  "description": "dsh-plugin: encrypted backup / restore / migration of the dsh home config through a private GitHub repo",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "plugin",
    "backup",
    "restore",
    "migration",
    "vault"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fan56/dsh-vault.git"
  },
  "homepage": "https://github.com/fan56/dsh-vault",
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "pretest": "tsc -p tsconfig.json",
    "test": "node --test test/crypto.test.mjs test/backupset.test.mjs test/manifest.test.mjs test/table.test.mjs test/command.test.mjs",
    "smoke": "node scripts/smoke-boot.mjs",
    "e2e": "./e2e/run-e2e.sh"
  },
  "dependencies": {},
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-commands": ">=0.1.2-alpha.3",
    "@deepseek-ai/dsh-settings": ">=0.1.2-alpha.3",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-commands": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-commands": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-settings": "0.1.2-alpha.3",
    "@deepseek-ai/schemastery": "3.18.2",
    "typescript": "^5.9.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "author": "fliu56",
  "publishConfig": {
    "access": "public"
  }
}
